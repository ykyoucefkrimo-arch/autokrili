###############################################################################
# Autokrili — marketplace de location de voitures en Algérie
#
# Copiez ce fichier en `.env`, puis lancez :
#   php artisan key:generate
#   php artisan migrate --seed
###############################################################################

APP_NAME=Autokrili
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Sans chemin ni sous-dossier : un prefixe ici est interprete comme faisant
# partie de la route, et toutes les URL repondent 404. Pour servir le projet
# sous WAMP, creez un virtual host pointant sur le dossier `public/`.
APP_URL=http://localhost:8000

# Interface en français ; la structure arabe existe mais n'est pas la langue par défaut.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

###############################################################################
# Journalisation
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Base de données — MySQL 8 (ou MariaDB 10.6+)
#
# Créez la base avant la première migration :
#   CREATE DATABASE autokrili CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# utf8mb4 n'est pas optionnel : les noms arabes des wilayas en dépendent.
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autokrili
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Sessions, cache, files d'attente
#
# Les emails partent en file d'attente (spécification §10). En développement le
# driver `database` suffit ; lancez `php artisan queue:work` pour les traiter.
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

###############################################################################
# Emails
#
# `log` en développement : les messages atterrissent dans storage/logs.
# Passez à `smtp` avec vos identifiants pour un envoi réel.
###############################################################################
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@autokrili.dz"
MAIL_FROM_NAME="${APP_NAME}"

# Passerelle SMS (§10). Desactivee tant qu'aucun operateur n'est choisi : un
# canal actif sans passerelle enverrait dans le vide tout en faisant croire
# que le client a ete prevenu. En developpement, LogSmsGateway ecrit dans
# storage/logs, ce qui permet de relire les textes avant de les facturer.
SMS_ENABLED=false
SMS_LOG_CHANNEL=stack

###############################################################################
# Stockage des fichiers
#
# Les photos de véhicules vont sur le disque `public` (lien symbolique créé par
# `php artisan storage:link`). Les registres de commerce restent sur le disque
# `local`, hors du dossier servi par le serveur web : ils ne sont lisibles que
# par une route protégée par policy (spécification §11).
###############################################################################
VITE_APP_NAME="${APP_NAME}"
